#, python-format
msgid "%(count)d minute"
msgid_plural "%(count)d minutes"
msgstr[0] "%(count)d דקה"
msgstr[1] "%(count)d דקות"
msgstr[2] "%(count)d דקות"
msgstr[3] "%(count)d דקות"

#, python-format
msgid "%(count)d hour"
msgid_plural "%(count)d hours"
msgstr[0] "%(count)d שעה"
msgstr[1] "%(count)d שעות"
msgstr[2] "%(count)d שעות"
msgstr[3] "%(count)d שעות"

msgid "Browse"
msgstr "חיפוש"

msgid "Add a Shul"
msgstr "הוספת בית כנסת"

msgid "About"
msgstr "אודות"

msgid "Contact"
msgstr "יצירת קשר"

msgid "Sign in"
msgstr "התחברות"

msgid "Admin"
msgstr "ניהול"

msgid "Form submission failed."
msgstr "שליחת הטופס נכשלה."

msgid "Please describe what happened before you were blocked..."
msgstr "נא לתאר מה קרה לפני החסימה..."

msgid "Why do you think this is a mistake?"
msgstr "למה לדעתך זו טעות?"

msgid "CAPTCHA verification failed. Please try again."
msgstr "אימות ה-CAPTCHA נכשל. נסו שוב."

msgid "Your appeal has been submitted. We'll review it and get back to you."
msgstr "הערעור נשלח. נבדוק אותו ונחזור אליך בהקדם."

msgid "Shul Name"
msgstr "שם בית הכנסת"

msgid "Address"
msgstr "כתובת"

msgid "Room Name"
msgstr "שם החדר"

msgid "E.g. Main Sanctuary, Beit Midrash"
msgstr "לדוגמה: אולם תפילה, בית מדרש"

msgid "Size of Women's Section"
msgstr "גודל עזרת הנשים"

msgid "How large is the women's section?"
msgstr "מה גודל עזרת הנשים?"

msgid "Visibility & Audibility"
msgstr "ראייה ושמיעה"

msgid "How well can you see and hear from the women's section, compared to the men's?"
msgstr "בהשוואה לעזרת הגברים, עד כמה ניתן לראות ולשמוע מעזרת הנשים?"

msgid "Kaddish"
msgstr "קדיש"

msgid "Can women say kaddish?"
msgstr "האם אפשר לנשים לומר קדיש?"

msgid "Equal or larger than men's"
msgstr "שווה לעזרת הגברים או גדולה יותר"

msgid "At least half men's size"
msgstr "לפחות חצי מגודל עזרת הגברים"

msgid "Less than half men's size"
msgstr "פחות מחצי מגודל עזרת הגברים"

msgid "No women's section"
msgstr "אין עזרת נשים"

msgid "Mixed seating"
msgstr "ישיבה מעורבת"

msgid "Can say alone"
msgstr "אפשר לומר לבד"

msgid "Can say, a man will always join"
msgstr "אפשר לומר, גבר תמיד מצטרף"

msgid "Only with men (ask or plan ahead)"
msgstr "רק אם גבר מצטרף (יש לשאול או לתאם מראש)"

msgid "Not allowed"
msgstr "לא מאפשרים"

msgid "Please select a valid address."
msgstr "נא לבחור כתובת תקינה."

msgid "At least one room is required."
msgstr "יש להוסיף לפחות חדר אחד."

msgid "Please explain why this shul should be deleted..."
msgstr "נא להסביר מדוע יש למחוק את בית הכנסת הזה..."

msgid ""
"Your answer will help us monitor deletions and decide whether to restore the "
"shul."
msgstr "התשובה שלך תעזור לנו לעקוב אחר מחיקות ולהחליט אם לשחזר את בית הכנסת."

msgid "Reason for deletion"
msgstr "סיבת המחיקה"

msgid "Verification Required"
msgstr "נדרש אימות"

msgid "Continue"
msgstr "להמשיך"

msgid "Contact Us"
msgstr "יצירת קשר"

msgid "The Ezrat Nashim Database"
msgstr "מאגר \"עזרת נשים\""

msgid "Email:"
msgstr "דוא\"ל:"

msgid "Follow:"
msgstr "עקבו אחרינו:"

msgid "Contact Form"
msgstr "טופס יצירת קשר"

msgid "Edit Shul"
msgstr "עריכת בית כנסת"

#, python-format
msgid "Edit Shul: %(shul_name)s"
msgstr "עריכת בית כנסת: %(shul_name)s"

msgid "Delete"
msgstr "מחיקה"

#, python-format
msgid "Step %(wizard_step)s of 2"
msgstr "שלב %(wizard_step)s מתוך 2"

msgid "(optional)"
msgstr "(לא חובה)"

msgid "Rooms"
msgstr "חדרים"

msgid "Back to Home"
msgstr "חזרה לדף הבית"

msgid "Next: Add Rooms"
msgstr "הבא: הוספת חדרים"

msgid "Save"
msgstr "שמירה"

msgid "Delete Shul"
msgstr "מחיקת בית כנסת"

msgid "Close"
msgstr "סגירה"

msgid ""
"The shul will be removed from public view immediately, but may be restored "
"after review."
msgstr "בית הכנסת יוסר מהתצוגה הציבורית מיד, אך ייתכן שישוחזר לאחר בדיקה."

msgid "Cancel"
msgstr "ביטול"

msgid "Add another room"
msgstr "עוד חדר"

msgid "Delete room"
msgstr "מחיקת חדר"

#, python-format
msgid "'%(shul_name)s' has been deleted."
msgstr "'%(shul_name)s' נמחק."

msgid "Was this a mistake?"
msgstr "נמחק בטעות?"

msgid "Undo"
msgstr "לשחזר"

msgid "Just Saved"
msgstr "נשמר כעת"

msgid "Nearby Shuls Found"
msgstr "נמצאו בתי כנסת בקרבת מקום"

msgid "We found other nearby shuls. Do you want to edit instead?"
msgstr "מצאנו עוד בתי כנסת בקרבת מקום. לערוך אחד מהם במקום להוסיף חדש?"

msgid "Edit"
msgstr "עריכה"

msgid "Continue Anyway"
msgstr "להמשיך בכל זאת"

msgid "Unable to load shul details."
msgstr "לא הצלחנו לטעון את פרטי בית הכנסת."

msgid "Loading..."
msgstr "טוען..."

msgid "Shul name hidden"
msgstr "שם בית הכנסת מוסתר"

#, python-format
msgid "%(counter)s Room"
msgid_plural "%(counter)s Rooms"
msgstr[0] "חדר אחד"
msgstr[1] "%(counter)s חדרים"
msgstr[2] "%(counter)s חדרים"
msgstr[3] "%(counter)s חדרים"

msgid "Directions"
msgstr "ניווט"

msgid "Updated"
msgstr "עודכן"

msgid "Kaddish:"
msgstr "קדיש:"

msgid "Size"
msgstr "גודל"

msgid "Vis. & Aud."
msgstr "ראייה ושמיעה"

#, python-format
msgid "%(counter)s Shul in this area"
msgid_plural "%(counter)s Shuls in this area"
msgstr[0] "בית כנסת אחד באזור זה"
msgstr[1] "%(counter)s בתי כנסת באזור זה"
msgstr[2] "%(counter)s בתי כנסת באזור זה"
msgstr[3] "%(counter)s בתי כנסת באזור זה"

#, python-format
msgid ""
"Restricted. <a href=\"%(contact_url)s\">Contact us</a> if this is a mistake."
msgstr "הגישה מוגבלת. אם זו טעות, <a href=\"%(contact_url)s\">צרו איתנו קשר</a>."

#, python-format
msgid "Too many requests. Try again in %(retry_after)s."
msgstr "יותר מדי בקשות. נסו שוב בעוד %(retry_after)s."

msgid "Sign in to see more"
msgstr "התחברו לצפייה בפרטים נוספים"

msgid "No longer available"
msgstr "כבר לא זמין"

msgid "This shul is no longer available."
msgstr "בית הכנסת הזה כבר לא זמין."

#, python-format
msgid "%(counter)s shul found"
msgid_plural "%(counter)s shuls found"
msgstr[0] "נמצא בית כנסת אחד"
msgstr[1] "נמצאו %(counter)s בתי כנסת"
msgstr[2] "נמצאו %(counter)s בתי כנסת"
msgstr[3] "נמצאו %(counter)s בתי כנסת"

msgid "Unnamed room"
msgstr "חדר ללא שם"

msgid "This room has errors. Click to review and fix."
msgstr "יש שגיאות בחדר הזה. לחצו כדי לבדוק ולתקן."

msgid "Filters"
msgstr "סינון"

msgid "Reset"
msgstr "איפוס"

msgid "Add Shul"
msgstr "הוספת בי\"כ"

msgid "Exact locations not displayed for security reasons"
msgstr "מטעמי ביטחון, המיקומים המדויקים אינם מוצגים"

msgid "Your Location"
msgstr "המיקום שלך"

msgid "Redirecting to Google Maps..."
msgstr "עובר לגוגל מפות..."

msgid "Unable to save. Check the form for errors."
msgstr "לא ניתן לשמור. יש לבדוק את שגיאות הטופס."

msgid "Fix the form errors to continue."
msgstr "יש לתקן את שגיאות הטופס כדי להמשיך."

msgid "Unable to delete. Please provide a valid reason."
msgstr "לא ניתן למחוק. נא לפרט את סיבת המחיקה."

msgid "Success! Your shul has been saved."
msgstr "בית הכנסת נשמר בהצלחה!"

#, python-format
msgid "'%(name)s' is not deleted."
msgstr "'%(name)s' אינו מחוק."

#, python-format
msgid "'%(name)s' has been restored."
msgstr "'%(name)s' שוחזר."

msgid "Details"
msgstr "פרטים"

msgid "What happened or what would you like to see?"
msgstr "מה קרה, או מה נוכל לשפר או להוסיף?"

msgid "50-2000 characters"
msgstr "50–2000 תווים"

msgctxt "feedback form field"
msgid "Email"
msgstr "דוא\"ל"

msgid "Screenshot"
msgstr "צילום מסך"

msgid "Up to 5mb"
msgstr "עד 5MB"

msgid "File size too large. Maximum size is 5MB."
msgstr "הקובץ גדול מדי. הגודל המקסימלי הוא 5MB."

msgid "File size must be less than 5MB"
msgstr "גודל הקובץ חייב להיות עד 5MB"

msgid "Send Feedback"
msgstr "שליחת משוב"

msgid "Send"
msgstr "שליחה"

msgid "Submitting..."
msgstr "שולח..."

msgid "No file chosen"
msgstr "לא נבחר קובץ"

msgid "Choose File"
msgstr "בחירת קובץ"

msgid "Unable to submit feedback. Please try again."
msgstr "לא הצלחנו לשלוח את המשוב. נסו שוב."

msgid "Thanks! We received your feedback and will review it soon."
msgstr "תודה! קיבלנו את המשוב שלך ונבדוק אותו בקרוב."

msgid "Page Not Found"
msgstr "הדף לא נמצא"

msgid "The page you're looking for doesn't exist or may have been moved."
msgstr "הדף המבוקש אינו קיים או שהועבר."

msgid "Back to Map"
msgstr "חזרה למפה"

msgid "Access Restricted"
msgstr "הגישה מוגבלת"

msgid "Temporarily Blocked"
msgstr "חסימה זמנית"

msgid "Something Went Wrong"
msgstr "משהו השתבש"

msgid "We're sorry, something unexpected happened. Please try again."
msgstr "מצטערים, קרתה תקלה לא צפויה. נסו שוב."

msgid "Mapping women's spaces in synagogues around the world"
msgstr "מיפוי עזרות נשים בבתי כנסת ברחבי העולם"

msgid ""
"We've detected unusual activity from your account and have restricted access."
msgstr "זיהינו פעילות חריגה בחשבון שלך והגישה הוגבלה."

msgid "If you believe this block is a mistake, please submit an appeal below."
msgstr "אם החסימה הזו היא טעות, אפשר להגיש ערעור למטה."

#, python-format
msgid ""
"If you believe this block is a mistake, please <a href=\"%(contact_url)s"
"\">contact us</a>."
msgstr ""
"אם החסימה הזו היא טעות, אפשר <a href=\"%(contact_url)s\">ליצור איתנו קשר</a>."

#, python-format
msgid ""
"We've detected too many requests from your account. Please wait <strong>"
"%(retry_after)s</strong> before trying again."
msgstr ""
"זיהינו יותר מדי בקשות מהחשבון שלך. נסו שוב בעוד <strong>%(retry_after)s</"
"strong>."

msgid "Submit an Appeal"
msgstr "הגשת ערעור"

msgid "Submit Appeal"
msgstr "שליחת ערעור"

msgid ""
"We've detected a high number of requests from your account. Verification is "
"required to continue."
msgstr "זיהינו מספר גדול של בקשות מהחשבון שלך. כדי להמשיך, נדרש אימות."

msgid "Built by"
msgstr "נבנה על ידי"

msgid "Ari Abramowitz logo"
msgstr "לוגו ארי אברמוביץ"

msgid "Ari Abramowitz"
msgstr "ארי אברמוביץ"

msgid "A project by Ari Abramowitz"
msgstr "פרויקט מאת ארי אברמוביץ"

msgid "Toggle navigation"
msgstr "פתיחת תפריט"

msgid "Account"
msgstr "חשבון"

msgid "Logout"
msgstr "התנתקות"

msgid "Login Error"
msgstr "שגיאת התחברות"

msgid ""
"An error occurred while attempting to login with Google. Please try again."
msgstr "אירעה שגיאה בעת ניסיון ההתחברות עם גוגל. נסו שוב."

msgid "Try Again"
msgstr "לנסות שוב"

msgctxt "page heading"
msgid "Login Cancelled"
msgstr "ההתחברות בוטלה"

msgid "You cancelled the Google login process."
msgstr "תהליך ההתחברות עם גוגל בוטל."

msgid "Activate this flag for users with any of these permissions."
msgstr "הפעלת הדגל הזה עבור משתמשים בעלי אחת מההרשאות האלה."
