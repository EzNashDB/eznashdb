msgid "Locate Me"
msgstr "מיקום נוכחי"

msgid "Reset"
msgstr "איפוס"

msgid "Please select a valid address."
msgstr "נא לבחור כתובת תקינה."

msgid "Select Location"
msgstr "בחירת מיקום"

msgid "An error occurred. Please try again."
msgstr "אירעה שגיאה. נסו שוב."

msgid "No results found."
msgstr "לא נמצאו תוצאות."

msgid "Try searching by city or street, then drag the map."
msgstr "נסו לחפש לפי עיר או רחוב, ואז להזיז את המפה."

msgid "Search by name or address..."
msgstr "חיפוש לפי שם או כתובת..."

msgid "Searching..."
msgstr "מחפש..."

msgid "Some results currently unavailable."
msgstr "חלק מהתוצאות אינן זמינות כעת."

msgid "Why?"
msgstr "למה?"

msgid "Why are some results unavailable?"
msgstr "למה חלק מהתוצאות לא זמינות?"

msgid ""
"We usually show address search results from Google Maps and OpenStreetMap, "
"but to keep costs low, we limit how many searches use Google each day."
msgstr ""
"בדרך כלל אנחנו מציגים תוצאות חיפוש כתובות מגוגל מפות ומ-OpenStreetMap, אבל "
"כדי לשמור על עלויות נמוכות יש הגבלה על מספר החיפושים היומי מול גוגל."

msgid "Right now, you're only seeing results from OpenStreetMap."
msgstr "כרגע מוצגות רק תוצאות מ-OpenStreetMap."

msgid ""
"If your shul doesn't appear in the results, try searching for the city or "
"street, then drag the map to the right location."
msgstr ""
"אם בית הכנסת שלך לא מופיע בתוצאות, נסו לחפש את העיר או הרחוב, ואז להזיז את "
"המפה למיקום הנכון."

msgid "Got it"
msgstr "הבנתי"

#, javascript-format
msgid "%s option selected"
msgid_plural "%s options selected"
msgstr[0] "נבחר פריט אחד"
msgstr[1] "נבחרו %s פריטים"
msgstr[2] "נבחרו %s פריטים"
msgstr[3] "נבחרו %s פריטים"

msgid "Remove this option"
msgstr "הסרת האפשרות"

msgid "Clear All"
msgstr "איפוס הכל"

msgid "Clear"
msgstr "איפוס"

msgid "Geolocation is not supported by your browser"
msgstr "הדפדפן שלך לא תומך באיתור מיקום"

msgid "Location requires a secure connection (HTTPS)"
msgstr "איתור מיקום דורש חיבור מאובטח (HTTPS)"

msgid ""
"Location access was denied. Check your browser's site settings to enable "
"location."
msgstr "הגישה למיקום נדחתה. יש לבדוק את הגדרות האתר בדפדפן כדי לאפשר גישה למיקום."

msgid "Location information is unavailable. Please try again."
msgstr "נתוני מיקום אינם זמינים. נסו שוב."

msgid "Location request timed out. Please try again."
msgstr "תם הזמן הקצוב לבקשת המיקום. נסו שוב."

msgid "Unable to retrieve your location."
msgstr "לא הצלחנו לאתר את המיקום שלך."
